{
  "title": "Payload",
  "description": "Payload CMS 3 (Next.js) in cms/: admin panel, REST API, site content and leads",
  "dbs": {
    "sqlite": {
      "title": "SQLite — один файл, без установки",
      "package": "@payloadcms/db-sqlite",
      "url": "file:./cms.db"
    },
    "postgres": {
      "title": "PostgreSQL — для боевых проектов (локально через Docker)",
      "package": "@payloadcms/db-postgres",
      "url": "postgres://payload:payload@localhost:5432/payload"
    }
  },
  "version": "3.91.0",
  "scripts": {
    "cms": "npm --prefix cms run dev",
    "cms:build": "npm --prefix cms run build",
    "cms:start": "npm --prefix cms run start"
  },
  "append": [
    "AGENTS.md",
    "README.md",
    "PROMT.md",
    ".gitignore"
  ],
  "pays": {
    "yookassa": {
      "title": "ЮKassa — карты, СБП, SberPay (Россия)",
      "env": [
        "YOOKASSA_SHOP_ID=",
        "YOOKASSA_SECRET_KEY=",
        "# Receipts under 54-FZ via \"Чеки от ЮKassa\": true + VAT code (1 — без НДС)",
        "YOOKASSA_RECEIPTS=false",
        "YOOKASSA_VAT_CODE=1"
      ]
    },
    "stripe": {
      "title": "Stripe — карты (для клиентов за рубежом)",
      "env": [
        "STRIPE_SECRET_KEY=",
        "STRIPE_WEBHOOK_SECRET=",
        "STRIPE_CURRENCY=rub"
      ]
    }
  },
  "payAppend": [
    "AGENTS.md",
    "README.md",
    "PROMT.md"
  ],
  "twofa": {
    "package": [
      "payload-totp",
      "3.0.6"
    ],
    "modes": {
      "optional": {
        "title": "по желанию — каждый включает в своём профиле",
        "required": "false"
      },
      "required": {
        "title": "обязательно для всех — без кода в админку не пустит",
        "required": "true"
      }
    },
    "append": [
      "AGENTS.md",
      "README.md",
      "PROMT.md",
      "PAYLOAD.md"
    ],
    "scripts": {
      "reset-2fa": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/reset-2fa.ts"
    }
  },
  "shop": {
    "title": "Магазин: каталог, корзина, заказы",
    "append": [
      "AGENTS.md",
      "README.md",
      "PROMT.md"
    ]
  }
}
