---
import { PackageIcon } from "lucide-react"

import { AddToCart } from "@/components/shop/add-to-cart"
import { formatRub } from "@/lib/cart"
import type { Product } from "@/data/shop"

interface Props {
  product: Product
}

const { product } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const href = `${base}/product/${product.slug}/`
const image = product.images[0]
---

<article class="group flex flex-col overflow-hidden rounded-xl border bg-card transition-shadow hover:shadow-lg">
  <a href={href} class="block aspect-square overflow-hidden bg-muted">
    {image ? (
      <img
        src={image.url}
        alt={image.alt}
        loading="lazy"
        class="size-full object-cover transition-transform group-hover:scale-105"
      />
    ) : (
      <div class="grid size-full place-items-center text-muted-foreground">
        <PackageIcon className="size-12" />
      </div>
    )}
  </a>
  <div class="flex flex-1 flex-col gap-2 p-4">
    <a href={href} class="font-medium hover:underline">
      {product.name}
    </a>
    <p class="mt-auto flex items-baseline gap-2">
      <span class="text-lg font-bold">{formatRub(product.price)}</span>
      {product.oldPrice && product.oldPrice > product.price && (
        <span class="text-sm text-muted-foreground line-through">
          {formatRub(product.oldPrice)}
        </span>
      )}
    </p>
    <AddToCart
      client:visible
      stock={product.stock}
      className="w-full"
      product={{
        id: product.id,
        slug: product.slug,
        name: product.name,
        price: product.price,
        image: image?.url,
      }}
    />
  </div>
</article>
