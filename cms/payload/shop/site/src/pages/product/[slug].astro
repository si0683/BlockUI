---
import { PackageIcon } from "lucide-react"

import ShopLayout from "@/layouts/shop.astro"
import { AddToCart } from "@/components/shop/add-to-cart"
import { getProducts } from "@/data/shop"
import { formatRub } from "@/lib/cart"

export async function getStaticPaths() {
  const products = await getProducts()
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }))
}

const { product } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const [image, ...more] = product.images
---

<ShopLayout title={product.name} description={product.description ?? undefined}>
  <nav class="mb-6 text-sm text-muted-foreground">
    <a href={`${base}/catalog/`} class="hover:text-foreground">
      Каталог
    </a>
    {product.category && (
      <>
        {" / "}
        <a
          href={`${base}/catalog/${product.category.slug}/`}
          class="hover:text-foreground"
        >
          {product.category.name}
        </a>
      </>
    )}
  </nav>

  <div class="grid gap-10 md:grid-cols-2">
    <div class="grid gap-3">
      <div class="aspect-square overflow-hidden rounded-xl border bg-muted">
        {image ? (
          <img src={image.url} alt={image.alt} class="size-full object-cover" />
        ) : (
          <div class="grid size-full place-items-center text-muted-foreground">
            <PackageIcon className="size-20" />
          </div>
        )}
      </div>
      {more.length > 0 && (
        <div class="grid grid-cols-4 gap-3">
          {more.map((extra) => (
            <img
              src={extra.url}
              alt={extra.alt}
              loading="lazy"
              class="aspect-square rounded-lg border object-cover"
            />
          ))}
        </div>
      )}
    </div>

    <div class="flex flex-col gap-5">
      <h1 class="text-3xl font-bold tracking-tight">{product.name}</h1>
      {product.sku && (
        <p class="text-sm text-muted-foreground">Артикул: {product.sku}</p>
      )}
      <p class="flex items-baseline gap-3">
        <span class="text-3xl font-bold">{formatRub(product.price)}</span>
        {product.oldPrice && product.oldPrice > product.price && (
          <span class="text-lg text-muted-foreground line-through">
            {formatRub(product.oldPrice)}
          </span>
        )}
      </p>
      <p
        class:list={[
          "text-sm",
          product.stock > 0 ? "text-primary" : "text-muted-foreground",
        ]}
      >
        {product.stock > 0
          ? `В наличии: ${product.stock} шт.`
          : "Нет в наличии"}
      </p>
      <AddToCart
        client:load
        size="lg"
        stock={product.stock}
        className="w-full sm:w-fit"
        product={{
          id: product.id,
          slug: product.slug,
          name: product.name,
          price: product.price,
          image: image?.url,
        }}
      />
      {product.description && (
        <p class="text-muted-foreground">{product.description}</p>
      )}
      {product.attributes.length > 0 && (
        <dl class="divide-y rounded-xl border text-sm">
          {product.attributes.map((attribute) => (
            <div class="flex justify-between gap-4 p-3">
              <dt class="text-muted-foreground">{attribute.name}</dt>
              <dd class="text-right">{attribute.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  </div>
</ShopLayout>
