---
import ShopLayout from "@/layouts/shop.astro"
import { CartView } from "@/components/shop/cart-view"
import { CMS_URL } from "@/data/shop"

const base = import.meta.env.BASE_URL.replace(/\/$/, "")
---

<ShopLayout title="Корзина">
  <h1 class="mb-6 text-3xl font-bold tracking-tight">Корзина</h1>
  <CartView client:load cmsUrl={CMS_URL} base={base} />
</ShopLayout>
