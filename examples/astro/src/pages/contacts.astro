---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contacts — Margherita">
  <!-- Map and form: Leaflet loads only on this page -->
  <section class="bui-section" id="contacts">
    <div class="bui-container">
      <div class="bui-head"><span class="bui-label">Contacts</span><h2>Come by or call us</h2></div>
      <div class="bui-split">
        <div>
          <div class="bui-contacts">
            <a class="bui-contact" href="tel:+442071234567"><span>📞</span><span><small>Phone</small><b>+44 20 7123 4567</b></span></a>
            <a class="bui-contact" href="mailto:hello@margherita.example"><span>✉️</span><span><small>Email</small><b>hello@margherita.example</b></span></a>
            <div class="bui-contact"><span>🕒</span><span><small>Open</small><b>Every day 11:00–23:00</b></span></div>
          </div>
          <form class="bui-form" data-thanks="Thanks! We will reply within an hour.">
            <div class="bui-field"><input name="name" required><label>Your name</label></div>
            <div class="bui-field"><input name="phone" type="tel" required><label>Phone</label></div>
            <div class="bui-field"><textarea name="message"></textarea><label>Message</label></div>
            <button class="bui-btn bui-btn-wide">Send</button>
          </form>
        </div>
        <div data-map="London, Covent Garden" data-label="Margherita — we are here"></div>
      </div>
    </div>
  </section>
</Layout>
