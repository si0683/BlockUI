---
// Shared layout: head, header, footer and the LightWebsiteUi start-up script
import 'lightwebsiteui/lightwebsiteui.css';
import { ClientRouter } from 'astro:transitions';

const { title = 'Margherita' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content="A pizzeria site built with LightWebsiteUi blocks in Astro.">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🍕</text></svg>">
  <!-- Smooth page changes without a reload. Delete this line for classic page loads: the script below works either way. -->
  <ClientRouter />
</head>
<body>

<!-- Theme toggle, cart and mobile menu are added by LightWebsiteUi -->
<header class="bui-header">
  <div class="bui-container">
    <a class="bui-logo" href="/"><span>🍕</span><span data-name>Margherita</span></a>
    <nav class="bui-nav">
      <a href="/">Home</a>
      <a href="/menu/">Menu</a>
      <a href="/contacts/">Contacts</a>
    </nav>
  </div>
</header>

<main>
  <slot />
</main>

<footer class="bui-footer">© <span data-year></span> <span data-name>Margherita</span> · built with LightWebsiteUi and Astro</footer>

<script>
  import LightWebsiteUi from 'lightwebsiteui';

  // The same settings as CONFIG in a plain 3-file site
  const CONFIG = {
    name: 'Margherita',
    style: 'cozy',
    color: 'red',
    lang: 'en',
    rain: '🍕',
    thanks: 'Thanks! We will call you back in 5 minutes.'
  };

  LightWebsiteUi.start(CONFIG);

  // With <ClientRouter /> the next page replaces <body> without a reload: enhance it
  document.addEventListener('astro:after-swap', () => LightWebsiteUi.refresh());
</script>
</body>
</html>
